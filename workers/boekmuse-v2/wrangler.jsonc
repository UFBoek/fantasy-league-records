{
  "name": "boekmuse-sql",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boekmuse-league-analytics",
      "database_id": "1c0ed566-50ef-40b8-85fe-ddd1d18d3c80"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ufboek.github.io"
  },
  "ratelimits": [
    {
      "name": "RATE",
      "namespace_id": "1003",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_RATE",
      "namespace_id": "1004",
      "simple": {
        "limit": 35,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "1,11,21,31,41,51 * * * *"
    ]
  }
}
